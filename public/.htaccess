# Mirissa Jetliner - SEO Friendly URLs
# This configuration removes the .html extension from URLs.

# Turn on the rewrite engine
RewriteEngine On

# 1. Externally redirect /file.html to /file
# This ensures that users and search engines see the clean URL.
# It's a 301 (permanent) redirect, which is good for SEO.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Internally rewrite /file to file.html
# This rule works behind the scenes to show the content of the .html file
# when a user requests the clean URL.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]