-    const email = getVal('email');
-    const phone = getVal('phone');
-    const date = getVal('tourDate');
-    const time = getSelectText('tourTime');
-    const adultCount = parseInt(getSelectVal('adultCount')) || 0;
-    const childCount = parseInt(getSelectVal('childCount')) || 0;
-    const requests = getVal('specialRequests');
-
-    // Validate
-    if (!name || !email || !phone || !date || !time || (adultCount === 0 && childCount === 0)) {
-      formError.style.display = 'block';
-      return false;
-    }
-    formError.style.display = 'none';
-
-    // Populate summary
-    document.getElementById('sName').textContent = name;
-    document.getElementById('sEmail').textContent = email;
-    document.getElementById('sPhone').textContent = phone;
-    document.getElementById('sDate').textContent = date;
-    document.getElementById('sTime').textContent = time;
-    document.getElementById('sAdult').textContent = adultCount + ' × LKR ' + ADULT_PRICE.toLocaleString();
-    document.getElementById('sChild').textContent = childCount + ' × LKR ' + CHILD_PRICE.toLocaleString();
-    document.getElementById('sRequests').textContent = requests || 'None';
-
-    const total = (adultCount * ADULT_PRICE) + (childCount * CHILD_PRICE);
-    document.getElementById('sTotal').textContent = formatCurrency(total);
-
-    // Build WhatsApp link
