-                `Total: LKR ${total.toLocaleString()}%0A` +
-                `Special Requests: ${requests || 'None'}`;
-
-    whatsappBtn.href = 'https://wa.me/94777728439?text=' + msg;
-    whatsappBtn.dataset.total = total;
-
-    return true;
-  }
